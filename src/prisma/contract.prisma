// use prisma-next
types {
  EmbeddingVector = pgvector.Vector(768)
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?

  aiSummary String?
  aiTags String?
  embedding String?
  chunks KnowledgeChunk[]

  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model RAGQueryLog {
  id             Int      @id @default(autoincrement())

  question      String

  retrievedCount Int

  topScore      Float?

  sourceIds     String?

  answer        String?

  createdAt     TimestamptzString @default(now())
}

model KnowledgeChunk {
  id Int @id @default(autoincrement())

  post Post @relation(
    fields: [postId],
    references: [id],
    onDelete: Cascade
  )
  postId Int

  chunkIndex Int
  text String
  startOffset Int
  endOffset Int

  embedding EmbeddingVector
  embeddingModel String

  createdAt TimestamptzString @default(now())

  @@unique([postId, chunkIndex])
  @@index([postId])
  @@map("knowledge_chunk")
}
