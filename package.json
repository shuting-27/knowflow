    "@prisma/orm-postgres": "8.0.0-rc.8",
    "dotenv": "^17.4.2",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "^8.0.0-rc.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
